# ==============================================================================
# Replix Mobile App - Environment Variables
# ==============================================================================
# Copy this file to .env before starting the development server:
#   cp .env.example .env
#
# IMPORTANT: All client-side environment variables in Expo SDK 54 must be prefixed 
# with EXPO_PUBLIC_ to be embedded in the JavaScript bundle at build time.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Configuration
# ------------------------------------------------------------------------------
# Get these from: Supabase Dashboard > Project Settings > API > Project URL & anon/public key
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# 2. PostHog Product Telemetry & Analytics
# ------------------------------------------------------------------------------
# Get these from: PostHog Dashboard > Project Settings > Project API Key & Host
EXPO_PUBLIC_POSTHOG_API_KEY="phc_your_posthog_project_api_key"
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ------------------------------------------------------------------------------
# 3. RevenueCat In-App Purchases & Subscriptions
# ------------------------------------------------------------------------------
# Get Apple Key from: RevenueCat Dashboard > Project Settings > Apps > iOS App > Public API Key
EXPO_PUBLIC_REVENUECAT_APPLE_KEY="appl_your_revenuecat_apple_public_key"

# Get Google Key from: RevenueCat Dashboard > Project Settings > Apps > Android App > Public API Key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY="goog_your_revenuecat_google_public_key"

# ==============================================================================
# Supabase Edge Functions Secrets (Set via Supabase CLI or Dashboard)
# ==============================================================================
# These variables are NOT included in the mobile client bundle. They must be set
# on your Supabase project using: supabase secrets set KEY=VALUE
#
# REVENUECAT_WEBHOOK_SECRET="your_shared_webhook_secret_for_rc_webhook"
# SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret"
# SUPABASE_URL="https://your-project-ref.supabase.co"